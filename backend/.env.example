# backend/.env 로 복사해 값 입력
PORT=
DATABASE_URL=
# e2e 테스트 전용 DB. 이름이 _test 로 끝나야 한다
DATABASE_URL_TEST=
COOKIE_SECURE=
TRUST_PROXY=
# 판정 AI: mock(기본, 모든 질문 IRRELEVANT) 또는 ollama
LLM_PROVIDER=
OLLAMA_BASE_URL=
# 기본 gemma3:12b (튜토리얼 평가 judge-v2 기준 97.1%). 사전 준비: ollama pull gemma3:12b
OLLAMA_MODEL=
LLM_TIMEOUT_MS=
# 로그인(PRD D30): google(실제, 아래 두 값 필요. 없으면 로그인 비활성) 또는 fake(개발·테스트 전용, 운영 금지)
AUTH_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 브라우저가 접속하는 프론트 주소. 구글 리디렉션 URI = PUBLIC_BASE_URL + /api/auth/google/callback
PUBLIC_BASE_URL=
# 일일 질문 한도(잠정, 0이면 제한 없음): 게스트 IP당 / 로그인 계정당 / 튜토리얼(별도)
DAILY_LIMIT_GUEST=
DAILY_LIMIT_USER=
DAILY_LIMIT_TUTORIAL=
# 월 AI 예산(원, 잠정, 0이면 제한 없음)과 정답 채점 예비 비율
MONTHLY_AI_BUDGET_KRW=
BUDGET_RESERVE_RATIO=
# IP 해시 비밀값(16자 이상, 운영에서는 반드시 설정). IP 원문은 저장하지 않는다.
IP_HASH_SECRET=
# 비공개 본편 사건 데이터 폴더(선택)
CASE_DATA_DIR=
