// MysteryTalk DB 스키마 (docs/SPEC.md §4).
// 변경은 반드시 `npm run migrate:dev -w backend`로 마이그레이션 파일을 만든다(prisma db push 금지).
// 적용·커밋된 마이그레이션은 수정하지 않고 새 파일을 추가한다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlayerKind {
  GUEST
  USER
}

/// 플레이어(게스트 또는 구글 로그인 사용자). 토큰 원문은 저장하지 않고 해시만 저장한다(SPEC §3.1).
model Player {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind           PlayerKind
  guestTokenHash String?    @unique @map("guest_token_hash")
  googleSub      String?    @unique @map("google_sub")
  /// 화면 고정 문구에만 쓰고 AI에 전달하지 않는다(PRD D40)
  detectiveName  String     @map("detective_name")
  settings       Json       @default("{}") @map("settings_json")
  ageConfirmedAt DateTime?  @map("age_confirmed_at") @db.Timestamptz
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  lastActiveAt   DateTime   @default(now()) @map("last_active_at") @db.Timestamptz
  /// 게스트 → 로그인 기록 이전 후 대상 사용자(SPEC §3.2)
  mergedIntoId   String?    @map("merged_into") @db.Uuid

  sessions     PlaySession[]
  records      CaseRecord[]
  authSessions AuthSession[]

  @@index([kind, lastActiveAt])
  @@map("player")
}

enum Difficulty {
  EASY
  NORMAL
  HARD
}

enum Rating {
  NORMAL
  STRONG
}

enum SessionStatus {
  ACTIVE
  SOLVED
  PARTIAL
  FAILED
  ABANDONED
}

enum QuestionLabel {
  YES
  NO
  MAYBE
  IRRELEVANT
  RETRY
}

enum RetryReason {
  COMPOUND
  OPEN
  ASKS_ANSWER
  UNCLEAR
  ABUSE
}

/// 등급(PRD §8.1). D는 부분 해결, F는 미해결·포기
enum Grade {
  S
  A
  B
  C
  D
  F
}

/// 제출 결과(SPEC §7). NEEDS_DETAIL = 채점 미확정 → 재작성 요청(미차감, D23)
enum SubmissionResult {
  SOLVED
  WRONG
  NEEDS_DETAIL
}

/// 구역이 열린 이유(D26). 사실 해금은 이유를 플레이어에게 밝히지 않는다(D81)
enum ZoneUnlockedBy {
  CLUE
  FACT
  HINT
}

/// 일일 사용량의 주체: 게스트는 IP 해시, 로그인은 플레이어 id
enum UsageSubject {
  IP
  PLAYER
}

enum AiPurpose {
  JUDGE
  GRADE
}

/// 사건 메타데이터. 판정용 사실 목록·정답 요소·힌트는 case_version 에 버전별로 둔다(SPEC §4.2, PRD D59).
/// 테이블명 case 는 SQL 예약어라 mystery_case 를 쓴다.
model MysteryCase {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String     @unique
  isTutorial     Boolean    @map("is_tutorial")
  title          String
  summary        String
  intro          String
  caseFile       Json       @map("case_file_json")
  difficulty     Difficulty
  baseQuestions  Int        @map("base_questions")
  rating         Rating
  tags           String[]
  genres         String[]
  /// 종료 후에만 공개한다
  explanation    String
  currentVersion Int        @map("current_version")
  isPublished    Boolean    @map("is_published")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  versions CaseVersion[]
  sessions PlaySession[]
  records  CaseRecord[]

  @@map("mystery_case")
}

/// 사건 버전별 비공개 데이터. 공개 API로 내보내지 않는다.
model CaseVersion {
  caseId      String   @map("case_id") @db.Uuid
  version     Int
  facts       Json     @map("facts_json")
  elements    Json     @map("elements_json")
  hints       Json     @map("hints_json")
  /// 현장 조사 데이터(맵·조사 대상·NPC·단서·시작 위치). 기존 버전은 빈 객체
  explore     Json     @default("{}") @map("explore_json")
  contentHash String   @map("content_hash")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz

  case MysteryCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@id([caseId, version])
  @@map("case_version")
}

/// 사건 1회 플레이. 사건당 진행 중(ACTIVE) 세션은 1개(PRD D54) → 마이그레이션의 부분 고유 인덱스로 강제한다.
model PlaySession {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId           String        @map("player_id") @db.Uuid
  caseId             String        @map("case_id") @db.Uuid
  caseVersion        Int           @map("case_version")
  playNo             Int           @map("play_no")
  status             SessionStatus @default(ACTIVE)
  questionsUsed      Int           @default(0) @map("questions_used")
  /// 해결 전 오답 횟수(3회면 종료, D12)
  wrongSubmissions   Int           @default(0) @map("wrong_submissions")
  /// 채점 미확정 재작성 요청 횟수(최대 2회, D23)
  detailRequestsUsed Int           @default(0) @map("detail_requests_used")
  /// 현장 조사 위치(맵 key, 좌표). 처음 조사 화면을 열 때 시작 위치로 정한다(D53, D56)
  currentMap         String?       @map("current_map")
  posX               Int?          @map("pos_x")
  posY               Int?          @map("pos_y")
  posSavedAt         DateTime?     @map("pos_saved_at") @db.Timestamptz
  /// 사건별 자유 메모 1개. AI에 전달하지 않는다(D62)
  memo               String        @default("")
  /// 종료 시 계산(SOLVED만 점수, D·F는 null)
  score              Int?
  grade              Grade?
  inFlightKey        String?       @map("in_flight_key") @db.Uuid
  inFlightUntil      DateTime?     @map("in_flight_until") @db.Timestamptz
  startedAt          DateTime      @default(now()) @map("started_at") @db.Timestamptz
  lastActiveAt       DateTime      @default(now()) @map("last_active_at") @db.Timestamptz
  finishedAt         DateTime?     @map("finished_at") @db.Timestamptz

  player      Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  case        MysteryCase   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  questions   QuestionLog[]
  aiCalls     AiCall[]
  submissions Submission[]
  hintViews   HintView[]
  clues       SessionClue[]
  zones       SessionZone[]

  @@index([playerId, caseId])
  @@map("play_session")
}

/// 질문·판정 기록. 같은 멱등성 키는 한 번만 저장된다.
model QuestionLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String        @map("session_id") @db.Uuid
  idempotencyKey String        @map("idempotency_key") @db.Uuid
  question       String
  /// 같은 문장 판정용(공백·문장부호 제거, D5)
  normalized     String
  label          QuestionLabel
  retryReason    RetryReason?  @map("retry_reason")
  factIds        Json          @default("[]") @map("fact_ids_json")
  counted        Boolean
  turnNo         Int?          @map("turn_no")
  caseVersion    Int           @map("case_version")
  model          String?
  promptVersion  String?       @map("prompt_version")
  /// 같은 키 재요청 시 그대로 돌려줄 응답
  response       Json          @map("response_json")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@unique([sessionId, turnNo])
  @@index([sessionId, normalized])
  @@map("question_log")
}

/// AI 호출 기록(비용·지연 측정, 월 예산 관리용, SPEC §10). 질문 원문은 저장하지 않는다.
model AiCall {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose    AiPurpose
  sessionId  String?   @map("session_id") @db.Uuid
  model      String
  tokensIn   Int?      @map("tokens_in")
  tokensOut  Int?      @map("tokens_out")
  estCostKrw Decimal   @default(0) @map("est_cost_krw") @db.Decimal(10, 4)
  latencyMs  Int       @map("latency_ms")
  ok         Boolean
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  session PlaySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("ai_call")
}

/// 정답 제출 기록(SPEC §7). 같은 멱등성 키는 한 번만 저장된다.
model Submission {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String           @map("session_id") @db.Uuid
  idempotencyKey String           @map("idempotency_key") @db.Uuid
  answer         String
  result         SubmissionResult
  /// 요소별 판정(키워드·AI·합의 결과). 종료 전에는 응답에 넣지 않는다(D84)
  matched        Json             @map("matched_json")
  matchedCount   Int              @map("matched_count")
  totalCount     Int              @map("total_count")
  caseVersion    Int              @map("case_version")
  model          String?
  promptVersion  String?          @map("prompt_version")
  /// 같은 키 재요청 시 그대로 돌려줄 응답
  response       Json             @map("response_json")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, createdAt])
  @@map("submission")
}

/// 힌트 열람 기록. PK로 같은 힌트의 이중 감점을 막는다(SPEC §9.1).
model HintView {
  sessionId String   @map("session_id") @db.Uuid
  hintNo    Int      @map("hint_no")
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, hintNo])
  @@map("hint_view")
}

/// 사건별 개인 기록(PRD D18): 최고 등급·달성 회차·총 플레이 횟수. 튜토리얼은 기록하지 않는다(D24).
model CaseRecord {
  playerId   String   @map("player_id") @db.Uuid
  caseId     String   @map("case_id") @db.Uuid
  bestGrade  Grade    @map("best_grade")
  bestScore  Int?     @map("best_score")
  bestPlayNo Int      @map("best_play_no")
  totalPlays Int      @map("total_plays")
  solved     Boolean
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  player Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  case   MysteryCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@id([playerId, caseId])
  @@map("case_record")
}

/// 세션에서 얻은 단서(조사·NPC 대화). PK로 중복 획득을 막는다(SPEC §9.2).
model SessionClue {
  sessionId String   @map("session_id") @db.Uuid
  clueKey   String   @map("clue_key")
  foundAt   DateTime @default(now()) @map("found_at") @db.Timestamptz

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, clueKey])
  @@map("session_clue")
}

/// 세션에서 열린 구역(처음부터 열린 맵은 기록하지 않는다).
model SessionZone {
  sessionId  String         @map("session_id") @db.Uuid
  mapKey     String         @map("map_key")
  unlockedBy ZoneUnlockedBy @map("unlocked_by")
  unlockedAt DateTime       @default(now()) @map("unlocked_at") @db.Timestamptz

  session PlaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, mapKey])
  @@map("session_zone")
}

/// 로그인 세션(SPEC §3.1). 쿠키 mt_session 의 토큰 원문은 저장하지 않고 해시만 저장한다. 30일, 쓰면 연장.
model AuthSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId   String   @map("player_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([expiresAt])
  @@map("auth_session")
}

/// 일일 질문 사용량(SPEC §10, PRD D58·D83). AI에 보낸 질문만 센다. IP는 날마다 바뀌는 비밀값을 섞은 해시만 저장한다.
model UsageDaily {
  day               DateTime     @db.Date
  subjectType       UsageSubject @map("subject_type")
  subjectHash       String       @map("subject_hash")
  questions         Int          @default(0)
  tutorialQuestions Int          @default(0) @map("tutorial_questions")

  @@id([day, subjectType, subjectHash])
  @@map("usage_daily")
}

/// 월 AI 예산(SPEC §10, PRD D46·D72). 질문은 (한도 − 예비)까지, 정답 채점은 한도까지 쓸 수 있다.
model BudgetMonth {
  month         String  @id
  limitKrw      Int     @map("limit_krw")
  reserveKrw    Int     @map("reserve_krw")
  spentJudgeKrw Decimal @default(0) @map("spent_judge_krw") @db.Decimal(12, 4)
  spentGradeKrw Decimal @default(0) @map("spent_grade_krw") @db.Decimal(12, 4)

  @@map("budget_month")
}
