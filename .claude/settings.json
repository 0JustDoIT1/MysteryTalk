{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.staging)",
      "Read(./**/.env.staging)",
      "Read(./.env.test)",
      "Read(./**/.env.test)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./.env.local)",
      "Edit(./**/.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./**/.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./**/.env.development)",
      "Edit(./.env.staging)",
      "Edit(./**/.env.staging)",
      "Edit(./.env.test)",
      "Edit(./**/.env.test)",
      "Edit(./.env.production)",
      "Edit(./**/.env.production)",
      "Write(./.env)",
      "Write(./**/.env)",
      "Write(./.env.local)",
      "Write(./**/.env.local)",
      "Write(./.env.*.local)",
      "Write(./**/.env.*.local)",
      "Write(./.env.development)",
      "Write(./**/.env.development)",
      "Write(./.env.staging)",
      "Write(./**/.env.staging)",
      "Write(./.env.test)",
      "Write(./**/.env.test)",
      "Write(./.env.production)",
      "Write(./**/.env.production)",
      "Read(./**/env.json)",
      "Edit(./**/env.json)",
      "Write(./**/env.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/secrets/**)",
      "Read(./**/credentials*.json)",
      "Read(./**/service-account*.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r -f*)",
      "Bash(rm -f -r*)",
      "Bash(docker volume rm*)",
      "Bash(docker compose down -v*)",
      "Bash(docker system prune*)",
      "Bash(supabase db reset --linked*)",
      "Bash(git push * +*)",
      "Bash(prisma db push*)",
      "Bash(npx prisma db push*)",
      "Bash(prisma migrate reset*)",
      "Bash(npx prisma migrate reset*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(pnpm add*)",
      "Bash(yarn add*)",
      "Bash(pip install*)",
      "Bash(flutter pub add*)",
      "Bash(dart pub add*)",
      "Bash(supabase db push*)",
      "Bash(alembic upgrade*)",
      "Bash(alembic downgrade*)",
      "Bash(prisma migrate*)",
      "Bash(vercel*)",
      "Bash(gh pr merge*)",
      "Bash(npx -y npm@12.2.2 install*)",
      "Bash(npx npm@12.2.2 install*)",
      "Bash(npm run migrate:dev*)",
      "Bash(npm run migrate:deploy*)",
      "Bash(npm run cleanup:guests*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete*)",
      "Bash(npm run eval*anthropic*)",
      "Edit(./backend/prisma/migrations/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 10,
            "statusMessage": "가드 검사 중"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/refine-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
