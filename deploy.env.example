# 운영 구성(docker-compose.prod.yml) 값. deploy.env 로 복사해 채운다(커밋 금지).
# 바꿔야 할 값 목록과 이유는 docs/DEPLOY.md '환경 변수'.

# DB(같은 서버의 db 서비스). 외부 DB를 쓰면 DATABASE_URL만 그 주소로
POSTGRES_USER=mysterytalk
POSTGRES_PASSWORD=
POSTGRES_DB=mysterytalk
DATABASE_URL=postgresql://mysterytalk:<POSTGRES_PASSWORD>@db:5432/mysterytalk

# 브라우저가 접속하는 주소(HTTPS). 구글 리디렉션 URI = PUBLIC_BASE_URL + /api/auth/google/callback
PUBLIC_BASE_URL=https://example.com
COOKIE_SECURE=true

# 판정·채점 AI. 배포용 클라우드 AI는 아직 미정(PRD §15). 미정인 동안은 mock(모든 질문 '관계없음')
LLM_PROVIDER=mock

# 로그인: 운영은 google(fake는 운영에서 시작 거부)
AUTH_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 16자 이상 무작위 값
IP_HASH_SECRET=

# 한도·예산(잠정, 비용 측정 후 조정)
DAILY_LIMIT_GUEST=60
DAILY_LIMIT_USER=200
DAILY_LIMIT_TUTORIAL=60
MONTHLY_AI_BUDGET_KRW=5000

# 버그 제보 외부 폼(선택, 빌드할 때 고정)
NEXT_PUBLIC_BUG_FORM_URL=
